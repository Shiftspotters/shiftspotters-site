---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import ShareButtons from '../components/ShareButtons.astro';
import FallbackImage from '../assets/og-fallback.png';
import { SITE_TITLE } from '../consts';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, lastFactChecked, heroImage } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();

// lastFactChecked is required on blog posts and absent on the About page — use it to gate BlogPosting emission.
const isBlogPost = Boolean(lastFactChecked);
const schemaImage = new URL((heroImage ?? FallbackImage).src, Astro.site).toString();
const blogPostingSchema = isBlogPost
	? {
			'@context': 'https://schema.org',
			'@type': 'BlogPosting',
			mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
			headline: title,
			description,
			image: schemaImage,
			datePublished: pubDate.toISOString(),
			dateModified: (updatedDate ?? pubDate).toISOString(),
			author: {
				'@type': 'Organization',
				name: SITE_TITLE,
				url: Astro.site?.toString(),
			},
			publisher: {
				'@type': 'Organization',
				name: SITE_TITLE,
				logo: {
					'@type': 'ImageObject',
					url: new URL('/favicon.svg', Astro.site).toString(),
				},
			},
		}
	: null;
---

<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			article={isBlogPost
				? {
						publishedTime: pubDate,
						modifiedTime: updatedDate ?? pubDate,
						author: SITE_TITLE,
					}
				: undefined}
		/>
		{blogPostingSchema && (
			<script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
		)}
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on,
			.last-fact-checked {
				font-style: italic;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <img width={1020} height={510} src={heroImage.src} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
							{
								lastFactChecked && (
									<div class="last-fact-checked">
										Last factchecked <FormattedDate date={lastFactChecked} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
					<ShareButtons title={title} url={canonicalUrl} />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
