---
interface Props {
	title: string;
	url: string;
}

const { title, url } = Astro.props;

const encodedTitle = encodeURIComponent(title);
const encodedUrl = encodeURIComponent(url);

const xUrl = `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`;
const linkedInUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`;
---

<div class="share-buttons">
	<span class="share-label">Share:</span>
	<a
		href={xUrl}
		target="_blank"
		rel="noopener noreferrer"
		aria-label="Share on X (formerly Twitter)"
		class="share-link x"
	>
		<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
			<path
				d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
			></path>
		</svg>
		<span class="visually-hidden">X</span>
	</a>
	<a
		href={linkedInUrl}
		target="_blank"
		rel="noopener noreferrer"
		aria-label="Share on LinkedIn"
		class="share-link linkedin"
	>
		<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
			<path
				d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
			></path>
		</svg>
		<span class="visually-hidden">LinkedIn</span>
	</a>
</div>

<style>
	.share-buttons {
		display: flex;
		align-items: center;
		gap: 0.75em;
		margin: 3em 0 1.5em 0;
		padding-top: 2em;
		border-top: 1px solid rgb(var(--gray-light, 229 233 240));
	}
	.share-label {
		color: rgb(var(--gray));
		font-size: 0.95em;
	}
	.share-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		background: rgb(var(--gray-light, 229 233 240));
		color: rgb(var(--gray-dark));
		text-decoration: none;
		transition: background 0.15s, color 0.15s, transform 0.15s;
	}
	.share-link:hover {
		background: rgb(var(--gray-dark));
		color: white;
		transform: translateY(-2px);
	}
	.share-link svg {
		width: 18px;
		height: 18px;
		fill: currentColor;
	}
	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
