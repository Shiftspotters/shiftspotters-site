---
const today = new Date();
---

<footer>
	<p>&copy; {today.getFullYear()} Shift Spotters. All rights reserved.</p>
	<p><a href="mailto:hello@shiftspotters.com">hello@shiftspotters.com</a></p>
</footer>

<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	footer p {
		margin: 0.25em 0;
	}
	footer a {
		color: rgb(var(--gray));
	}
	footer a:hover {
		color: rgb(var(--gray-dark));
	}
</style>
