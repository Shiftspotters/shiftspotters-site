---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Shift Spotters</h1>
				<p class="tagline">Pattern-spotting the AI-tool ecosystem.</p>
				<p class="intro">
					Category tours, honest reads on where specific tools sit, and analysis of the shifts
					that actually matter versus what's just noise. Written for developers, framed clearly
					enough for anyone deciding which AI tools their team should bet on.
					<a href="/about/">More about the site →</a>
				</p>
			</section>

			<section class="posts">
				<h2>Recent posts</h2>
				{posts.length === 0 ? (
					<p class="empty">No posts yet — first article coming soon.</p>
				) : (
					<ul>
						{posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<h3 class="post-title">{post.data.title}</h3>
									<p class="post-date">
										<FormattedDate date={post.data.pubDate} />
									</p>
									{post.data.description && <p class="post-desc">{post.data.description}</p>}
								</a>
							</li>
						))}
					</ul>
				)}
			</section>
		</main>
		<Footer />

		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}
			.hero {
				margin-bottom: 3em;
				padding-bottom: 2em;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.hero h1 {
				margin-bottom: 0.5em;
			}
			.tagline {
				font-size: 1.4em;
				color: rgb(var(--gray-dark));
				margin-bottom: 1em;
			}
			.intro {
				color: rgb(var(--gray));
			}
			.posts h2 {
				margin-bottom: 1em;
			}
			.posts ul {
				list-style: none;
				padding: 0;
			}
			.posts li {
				margin-bottom: 2em;
			}
			.posts a {
				color: inherit;
				text-decoration: none;
			}
			.posts a:hover .post-title {
				color: var(--accent);
			}
			.post-title {
				margin: 0 0 0.25em 0;
			}
			.post-date {
				color: rgb(var(--gray));
				margin: 0 0 0.5em 0;
				font-size: 0.9em;
			}
			.post-desc {
				color: rgb(var(--gray-dark));
				margin: 0;
			}
			.empty {
				color: rgb(var(--gray));
				font-style: italic;
				padding: 2em;
				text-align: center;
				border: 1px dashed rgb(var(--gray-light));
				border-radius: 8px;
			}
		</style>
	</body>
</html>
